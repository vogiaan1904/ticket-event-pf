<mxfile host="drawio"><diagram name="inventory-reserve" id="inventory-reserve"><mxGraphModel dx="1600" dy="620" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="620" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Inventory — a hold that can never oversell" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=middle;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&#x27;text-align:left;font-family:Menlo,monospace;font-size:12px;line-height:1.45&#x27;&gt;&lt;b&gt;Reserve(order_code, items, expires_at)&lt;/b&gt; — one transaction&lt;br&gt;&lt;br&gt;for each ticket class, in ascending id:&lt;br&gt;&amp;nbsp;&amp;nbsp;UPDATE ticket_class&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SET reserved = reserved + qty&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;WHERE id = ? AND status = &#x27;ACTIVE&#x27;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;AND now() within the sale window&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;AND reserved + sold + qty &amp;lt;= total&lt;/b&gt;&lt;br&gt;INSERT reservation rows (ACTIVE, expires_at)&lt;br&gt;COMMIT&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#E6F6FB;strokeColor=#0E9FC4;fontColor=#0B3B4A;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="470" height="250" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 row per class&lt;/b&gt;&lt;br&gt;held — no prior read, no FOR UPDATE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#EAF7EE;strokeColor=#2E7D32;fontColor=#1B4D20;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="225" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;0 rows&lt;/b&gt; → read unlocked to say why:&lt;br&gt;NOT_FOUND · FAILED_PRECONDITION" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FDEDED;strokeColor=#C62828;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="285" y="350" width="225" height="64" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;strokeColor=#374151;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="160" y="320" as="sourcePoint"/><mxPoint x="160" y="350" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c7" value="" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;strokeColor=#374151;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="400" y="320" as="sourcePoint"/><mxPoint x="400" y="350" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;ticket_class&lt;/b&gt;  total · reserved · sold&lt;br&gt;CHECK reserved + sold ≤ total" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="470" height="76" as="geometry"/></mxCell><mxCell id="c9" value="Postgres re-checks the WHERE against the newest committed row after taking the row lock, so the UPDATE&#x27;s row count is the verdict. The lock is held to COMMIT: one hot class ≈ 1,300 reserves/s, measured." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="470" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;A reservation&#x27;s life&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="600" height="26" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;holds qty in reserved" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#E6F6FB;strokeColor=#0E9FC4;fontColor=#0B3B4A;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="150" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;CONFIRMED&lt;/b&gt;&lt;br&gt;reserved → sold" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#EAF7EE;strokeColor=#2E7D32;fontColor=#1B4D20;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="180" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;reserved −= qty" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1010" y="290" width="180" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;EXPIRED&lt;/b&gt;&lt;br&gt;reserved −= qty" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1010" y="470" width="180" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;stock gone&lt;/b&gt;&lt;br&gt;order becomes REFUND_REQUIRED" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FDEDED;strokeColor=#C62828;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="1320" y="470" width="230" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Reserve" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;strokeColor=#374151;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="318" as="sourcePoint"/><mxPoint x="620" y="318" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c17" value="Confirm (payment arrived)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;strokeColor=#374151;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0.35" relative="1" as="geometry"><mxPoint x="695" y="290" as="sourcePoint"/><mxPoint x="1010" y="138" as="targetPoint"/><Array as="points"><mxPoint x="695" y="138"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c18" value="Release (saga compensation)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;strokeColor=#374151;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="770" y="318" as="sourcePoint"/><mxPoint x="1010" y="318" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c19" value="expiry worker, every minute:&lt;br&gt;past expires_at" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;strokeColor=#374151;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0.35" relative="1" as="geometry"><mxPoint x="695" y="346" as="sourcePoint"/><mxPoint x="1010" y="498" as="targetPoint"/><Array as="points"><mxPoint x="695" y="498"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c20" value="late Confirm re-acquires&lt;br&gt;from free stock" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;strokeColor=#374151;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1190" y="488" as="sourcePoint"/><mxPoint x="1190" y="138" as="targetPoint"/><Array as="points"><mxPoint x="1270" y="488"/><mxPoint x="1270" y="138"/></Array><mxPoint x="78" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c21" value="no stock left" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#7F1D1D;strokeColor=#C62828;strokeWidth=1.4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1190" y="510" as="sourcePoint"/><mxPoint x="1320" y="510" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c22" value="An ACTIVE hold past expires_at is still confirmed: it holds its quantity until the sweep, so a late payment is never refused. The hold outlives the payment window (6 min + 3 min grace), so the sweep should never win that race." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="930" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>