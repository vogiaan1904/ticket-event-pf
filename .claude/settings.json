{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-comment-budget.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking comment conventions"
          }
        ]
      }
    ]
  }
}
