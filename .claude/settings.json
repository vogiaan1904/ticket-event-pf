{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-comment-budget.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking comment conventions"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-decision-records.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking decision records"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/working-stance.md\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
