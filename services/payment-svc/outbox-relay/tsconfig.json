{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "../lambdas/common/db/**/*",
    "../lambdas/common/kafka/**/*",
    "../lambdas/common/logger/**/*",
    "../lambdas/common/constants/**/*",
    "../lambdas/common/types/event.types.ts"
  ],
  "exclude": ["node_modules", "dist", "../lambdas/common/db/__tests__"]
}
